# --------------------------------------------------
# Sentinel Web-Risk Intelligence
# Example environment configuration
# --------------------------------------------------

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Execution mode
# real = use configured external providers
# mock = use deterministic local testing providers
EXECUTION_MODE=real

# AI / LLM provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.aimlapi.com/v1
FREE_TIER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Bright Data
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_API_URL=https://api.brightdata.com/request
BRIGHT_DATA_WEB_UNLOCKER_URL=https://api.brightdata.com/request

BRIGHT_DATA_PROXY_HOST=brd.superproxy.io
BRIGHT_DATA_PROXY_PORT=33335
BRIGHT_DATA_PROXY_USER=
BRIGHT_DATA_PROXY_PASS=
BRIGHT_DATA_ZONE=datacenter

# Optional proxy mappings
DATA_CENTER_PROXY=
ISP_PROXY=

# Storage
DATABASE_URL=sqlite:///./sentinel.db
CHROMA_PERSIST_DIR=./chroma_db

# Security
# Replace this locally with a securely generated value.
SECRET_KEY=replace-with-a-secure-random-secret
